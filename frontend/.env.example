# =============================================================================
# PowerChain Copilot Frontend — Public Expo Environment
# Version 1.0.0
# =============================================================================
#
# IMPORTANT:
# Every EXPO_PUBLIC_* value is bundled into the client application.
# NEVER place private API keys, database credentials, wallet secrets,
# private keys, OpenAI secrets, Pyth secrets or Birdeye secrets here.

# -----------------------------------------------------------------------------
# App / release
# -----------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_RELEASE_VERSION=1.0.0

# -----------------------------------------------------------------------------
# PowerChain API
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1/capilot-mobile

# -----------------------------------------------------------------------------
# Solana
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SOLANA_NETWORK=devnet
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional environment-specific token overrides.
# Leave blank to use the application registry/default.
EXPO_PUBLIC_PWRC_MINT=
EXPO_PUBLIC_USDC_MINT=
EXPO_PUBLIC_EURC_MINT=

# Token-2022 program is public chain metadata, not a secret.
EXPO_PUBLIC_TOKEN_2022_PROGRAM=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb

# -----------------------------------------------------------------------------
# Sui read-network metadata
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUI_NETWORK=testnet
EXPO_PUBLIC_SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# -----------------------------------------------------------------------------
# Feature presentation
# -----------------------------------------------------------------------------
EXPO_PUBLIC_ENABLE_AI=true
EXPO_PUBLIC_ENABLE_MARKET_DATA=true
EXPO_PUBLIC_ENABLE_NOTIFICATIONS=true
