{
  "name": "@powerchain/copilot-frontend",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "main": "index.js",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "prestart": "node scripts/preflight.mjs",
    "start": "expo start",
    "web": "expo start --web",
    "web:clear": "expo start --web --clear",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "dev": "expo start --dev-client",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "doctor": "expo-doctor",
    "expo:fix": "expo install --fix",
    "verify:config": "node scripts/verify-config.mjs",
    "verify:imports": "node scripts/verify-imports.mjs",
    "verify:expo": "node scripts/verify-expo.mjs",
    "verify": "pnpm run verify:config && pnpm run verify:imports && pnpm run verify:bootstrap && pnpm run typecheck:bootstrap",
    "verify:installed": "pnpm run verify && pnpm run verify:expo && pnpm run typecheck:expo",
    "clean": "node scripts/clean.mjs",
    "typecheck:bootstrap": "tsc --noEmit -p tsconfig.json",
    "typecheck:expo": "tsc --noEmit -p tsconfig.expo.json",
    "verify:bootstrap": "node scripts/verify-bootstrap-tsconfig.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.0",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@solana/web3.js": "^1.98.0",
    "@wallet-ui/react-native-web3js": "4.3.0",
    "@web3icons/react": "^4.1.21",
    "bs58": "^6.0.0",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.11",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-quick-crypto": "^0.7.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.0.0",
    "react-native-web": "^0.21.0",
    "@powerchain/pwrc-credits": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.23.0"
}
