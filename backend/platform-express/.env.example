NODE_ENV=development
ENERGY_API_HOST=127.0.0.1
ENERGY_API_PORT=8200
ENERGY_API_PREFIX=/api/v1
ENERGY_DATA_MODE=live

# Transactional authority for this isolated backend workspace.
ENERGY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/powerchain_energy

# Auth provider: development | supabase
ENERGY_AUTH_PROVIDER=development
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SUI_NETWORK=devnet
SUI_RPC_URL=https://fullnode.devnet.sui.io:443

MARKET_DATA_PROVIDERS=pyth,birdeye,coingecko
ACTION_EXECUTION_ENABLED=false
EMS_CONTROL_PLANE_URL=
EMS_CONTROL_PLANE_SECRET=
IOT_CONTROL_PLANE_URL=
IOT_CONTROL_PLANE_SECRET=
DEPIN_CONTROL_PLANE_URL=
DEPIN_CONTROL_PLANE_SECRET=
ACTION_CONFIRMATION_TTL_SECONDS=120

CORS_ORIGINS=http://127.0.0.1:8081,http://localhost:3000
