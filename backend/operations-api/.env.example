NODE_ENV=development
OPERATIONS_API_HOST=127.0.0.1
OPERATIONS_API_PORT=8092
OPERATIONS_INTERNAL_BEARER_SECRET=
OPERATIONS_DATA_MODE=unavailable

# Domain feature gates
EMS_ENABLED=true
IOT_ENABLED=true
DEPIN_ENABLED=true
MARKET_DATA_ENABLED=true
SAFE_ACTIONS_ENABLED=true
ALARMS_ENABLED=true
EVENTS_ENABLED=true
DIGITAL_TWIN_ENABLED=true

# Authoritative operations persistence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/powerchain_operations
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Read-only infrastructure providers
SOLANA_RPC_URL=https://api.devnet.solana.com
SUI_RPC_URL=https://fullnode.devnet.sui.io:443
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_API_KEY_HEADER=x-api-key

# Freshness controls
TELEMETRY_FRESH_SECONDS=120
IOT_FRESH_SECONDS=300
DEPIN_FRESH_SECONDS=300
ALARM_FRESH_SECONDS=900
EVENT_FRESH_SECONDS=900

# Bounded queries / ingestion / provider I/O
OPERATIONS_PAGE_SIZE_DEFAULT=50
OPERATIONS_PAGE_SIZE_MAX=200
OPERATIONS_INGEST_BATCH_MAX=100
OPERATIONS_PROVIDER_TIMEOUT_MS=8000
OPERATIONS_PROVIDER_RESPONSE_MAX_BYTES=524288
SAFE_ACTION_TTL_SECONDS=600
