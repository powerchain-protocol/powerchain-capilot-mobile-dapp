{
  "name": "@powerchain/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "PowerChain Copilot Mobile Expo application",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ../../scripts/mobile-expo.mjs start",
    "start:clear": "node ../../scripts/mobile-expo.mjs start --clear",
    "android": "node ../../scripts/mobile-expo.mjs start --android",
    "ios": "node ../../scripts/mobile-expo.mjs start --ios",
    "web": "node ../../scripts/mobile-expo.mjs start --web",
    "native:android": "node ../../scripts/mobile-expo.mjs run:android",
    "native:ios": "node ../../scripts/mobile-expo.mjs run:ios",
    "prebuild": "node ../../scripts/mobile-expo.mjs prebuild --clean",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@powerchain/operations-contracts": "workspace:*",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~56.0.14",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.27.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3",
    "@types/node": "^22.15.0"
  },
  "type": "module"
}
