generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "nodejs"
}

datasource db { provider = "postgresql" }

model EnergySite {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  country        String?
  timezone       String?
  assets         EnergyAsset[]
  devices        IotDevice[]
  depinNodes     DepinNode[]
  accessGrants   SiteAccess[]
  walletLinks    WalletIdentity[]
  alarms         OperationalAlarm[]
  journalEvents  OperationalEventJournal[]
  twinSnapshots  DigitalTwinSnapshot[]
  evidence       EvidenceEnvelopeRecord[]
  ingestionReceipts TelemetryIngestionReceipt[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([organizationId])
}

model SiteAccess {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  siteId         String
  site           EnergySite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  role           String   @default("viewer")
  permissions    Json
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([organizationId, userId, siteId])
  @@index([organizationId, userId])
  @@index([siteId])
}

model EnergyAsset {
  id              String   @id @default(uuid())
  organizationId  String
  siteId          String
  site             EnergySite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name            String
  kind            String
  capacityMw      Decimal? @db.Decimal(24, 9)
  status          String   @default("UNKNOWN")
  resourceVersion Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([organizationId, siteId])
}

model IotDevice {
  id              String   @id @default(uuid())
  organizationId  String
  siteId          String
  site             EnergySite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name            String
  kind            String
  manufacturer    String?
  model           String?
  serialNumber    String?
  firmwareVersion String?
  connectivity    String   @default("UNKNOWN")
  lastSeenAt      DateTime?
  telemetry       TelemetryReading[]
  ingestionReceipts TelemetryIngestionReceipt[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([organizationId, siteId])
}

model TelemetryReading {
  id             String   @id @default(uuid())
  organizationId String
  deviceId       String
  device         IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  metric         String
  value          Decimal  @db.Decimal(38, 12)
  unit           String
  quality        String   @default("GOOD")
  source         String
  sourceSequence Decimal? @db.Decimal(78, 0)
  payloadHash    String?
  idempotencyKey String?
  isLate         Boolean  @default(false)
  observedAt     DateTime
  receivedAt     DateTime @default(now())
  @@index([organizationId, deviceId, metric, observedAt])
  @@index([organizationId, source, sourceSequence])
}

model DepinNode {
  id                    String   @id @default(uuid())
  organizationId        String
  siteId                String?
  site                  EnergySite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  network               String
  nodeType              String
  operatorId             String?
  region                 String?
  status                 String   @default("UNKNOWN")
  identityReference      String?
  lastHeartbeatAt        DateTime?
  rewardAsset            String?
  rewardAmountBaseUnits  Decimal? @db.Decimal(78, 0)
  rewardDecimals         Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  @@index([organizationId, network])
  @@index([organizationId, siteId])
}

model WalletIdentity {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  siteId         String?
  site           EnergySite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  chain          String
  address        String
  label          String?
  isPrimary      Boolean  @default(false)
  verifiedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([organizationId, chain, address])
  @@index([organizationId, userId])
}

model SafeAction {
  id                      String   @id @default(uuid())
  organizationId          String
  actorId                  String
  siteId                   String?
  type                      String
  payload                   Json
  summary                   Json
  state                     String
  policyReasons             Json
  idempotencyKey            String
  intentHash                String
  requestId                 String
  traceId                   String
  expectedResourceVersion   Int?
  resourceVersion           Int      @default(1)
  expiresAt                 DateTime
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, state])
  @@index([organizationId, siteId])
}

model OperationalOutbox {
  id               String   @id
  organizationId   String
  siteId            String?
  aggregateType     String
  aggregateId       String
  aggregateVersion  Int
  eventType          String
  schemaVersion      String
  payload            Json
  requestId          String
  traceId            String
  occurredAt         DateTime
  publishedAt        DateTime?
  publishAttempts    Int      @default(0)
  lastPublishAttemptAt DateTime?
  lastPublishError   String?
  nextAttemptAt      DateTime?
  createdAt          DateTime @default(now())
  @@index([organizationId, occurredAt])
  @@index([publishedAt, nextAttemptAt, occurredAt])
}


model TelemetryIngestionReceipt {
  id             String   @id @default(uuid())
  organizationId String
  siteId         String
  site           EnergySite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  deviceId       String
  device         IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  source         String
  sourceSequence Decimal   @db.Decimal(78, 0)
  idempotencyKey String
  payloadHash    String
  observedAt     DateTime
  receivedAt     DateTime
  status         String
  readingId      String?
  reasonCode     String?
  createdAt      DateTime @default(now())
  @@unique([organizationId, source, idempotencyKey])
  @@unique([organizationId, deviceId, source, sourceSequence])
  @@index([organizationId, siteId, createdAt])
}

model OperationalAlarm {
  id             String   @id @default(uuid())
  organizationId String
  siteId         String
  site           EnergySite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sourceType     String
  sourceId       String?
  code           String
  title          String
  message        String
  severity       String
  status         String   @default("open")
  observedAt     DateTime
  receivedAt     DateTime
  sourceSequence Decimal? @db.Decimal(78, 0)
  payloadHash    String
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([organizationId, siteId, status, severity])
  @@index([organizationId, siteId, observedAt])
}

model OperationalEventJournal {
  id             String   @id @default(uuid())
  organizationId String
  siteId         String
  site           EnergySite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  eventType      String
  aggregateType  String
  aggregateId    String
  severity       String
  source         String
  sourceSequence Decimal? @db.Decimal(78, 0)
  payload        Json
  payloadHash    String
  observedAt     DateTime
  receivedAt     DateTime
  requestId      String
  traceId        String
  createdAt      DateTime @default(now())
  @@index([organizationId, siteId, createdAt])
  @@index([organizationId, aggregateType, aggregateId, createdAt])
}

model DigitalTwinSnapshot {
  id               String   @id @default(uuid())
  organizationId   String
  siteId            String
  site              EnergySite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  asOf              DateTime
  operationalState  String
  mode              String
  authoritative     Boolean
  emsState           Json
  iotHealth          Json
  depinHealth        Json
  alarmCounts        Json
  reasons            Json
  sourceWatermarks   Json
  payloadHash        String
  createdAt          DateTime @default(now())
  @@index([organizationId, siteId, asOf])
}

model EvidenceEnvelopeRecord {
  id              String   @id @default(uuid())
  organizationId  String
  siteId           String
  site             EnergySite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  kind             String
  classification   String
  source           String
  truthTier        String
  validationState  String
  contentHash      String
  payload           Json
  observedAt        DateTime
  receivedAt        DateTime
  authoritative     Boolean
  label             String
  createdAt         DateTime @default(now())
  @@index([organizationId, siteId, createdAt])
  @@index([contentHash])
}
