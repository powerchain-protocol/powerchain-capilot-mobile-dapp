NODE_ENV=development
APP_VERSION=1.0.0

OPERATIONS_API_HOST=127.0.0.1
OPERATIONS_API_PORT=8200
OPERATIONS_API_PREFIX=/api/v1
OPERATIONS_DATA_MODE=live
OPERATIONS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/powerchain_operations

# development | internal | supabase
OPERATIONS_AUTH_PROVIDER=development
# Required when Fastify is the public gateway.
OPERATIONS_INTERNAL_SECRET=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REALTIME_ENABLED=false
SUPABASE_REALTIME_CHANNEL=powerchain-operations

SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SUI_NETWORK=devnet
SUI_RPC_URL=https://fullnode.devnet.sui.io:443

MARKET_DATA_PROVIDERS=coingecko
PYTH_HERMES_URL=https://hermes.pyth.network
BIRDEYE_BASE_URL=https://public-api.birdeye.so
BIRDEYE_API_KEY=
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

TELEMETRY_FRESH_SECONDS=30
TELEMETRY_STALE_SECONDS=120
SAFE_ACTION_TTL_SECONDS=180

CONTRACTS_VERSION=1.0.0
DATABASE_SCHEMA_VERSION=20260826090000
EVENT_SCHEMA_VERSION=1.0.0

CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
