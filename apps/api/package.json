{
  "name": "@powerchain/copilot-mobile-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "prisma:deploy": "prisma migrate deploy --config prisma.config.ts",
    "env:check": "tsx src/config/check-env.ts",
    "verify:contract": "node ../../scripts/verify-api-contract.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bs58": "^6.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "openai": "^6.0.0",
    "pg": "^8.0.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.0.0",
    "@powerchain/pwrc-credits": "workspace:*",
    "@powerchain/mcp-client": "workspace:*",
    "mongodb": "^6.0.0",
    "redis": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "version": "1.0.0",
  "license": "MIT"
}
