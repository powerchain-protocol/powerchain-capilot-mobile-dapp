POSTGRES_PORT=5432
POSTGRES_DB=powerchain_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL=false
PRISMA_LOG_LEVEL=warn
PRISMA_ACCELERATE_URL=

# Supabase
