# =============================================================================
# PowerChain Dashboard / Copilot / Mobile App
# Environment Configuration v1.0.0
# =============================================================================

# Runtime
NODE_ENV=development
APP_ENV=development
APP_NAME=PowerChain Copilot
APP_VERSION=1.0.0
LOG_LEVEL=debug
DEBUG=false

# Expo / Mobile - PUBLIC (never put secrets in EXPO_PUBLIC_*)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
EXPO_PUBLIC_NETWORK=devnet
EXPO_PUBLIC_SOLANA_NETWORK=devnet
EXPO_PUBLIC_SUI_NETWORK=devnet
EXPO_PUBLIC_DATA_MODE=demo
EXPO_PUBLIC_AI_MODE=managed
EXPO_PUBLIC_APP_NAME=PowerChain Copilot
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_CREDIT_TOKEN=PWRC
EXPO_PUBLIC_CREDIT_NETWORK=devnet
EXPO_PUBLIC_PWRC_MINT=

# API / Backend
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
API_BASE_URL=http://127.0.0.1:8000
INTERNAL_API_URL=http://127.0.0.1:8000/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SETTINGS_ENCRYPTION_KEY=
INTERNAL_API_SECRET=
INTERNAL_HMAC_SECRET=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# PostgreSQL / Prisma
