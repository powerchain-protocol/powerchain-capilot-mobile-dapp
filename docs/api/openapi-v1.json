    "/api/v1/actions/prepare": {
      "post": {
        "tags": [
          "Safe Actions"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Prepare an action without executing it",
        "description": "Fail-closed preparation only. Physical execution, server-side transaction execution, and server-side wallet signing are disabled.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
