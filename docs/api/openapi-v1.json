          "Chat"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List decrypted API DTO messages from encrypted-at-rest storage",
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Messages; ciphertext is never serialized"
