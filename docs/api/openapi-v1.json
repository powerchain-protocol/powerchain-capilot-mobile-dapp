        "responses": {
          "200": {
            "description": "Conversation summaries"
          }
        }
      },
      "post": {
        "tags": [
          "Chat"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Create a user-scoped encrypted conversation",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationCreate"
