# =============================================================================
# PowerChain Copilot API — Server Environment
# Version 1.0.0
# =============================================================================
#
# Copy to server/.env for local API development.
# Never expose this file to the Expo client.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

HOST=0.0.0.0
PORT=3001
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000
CORS_ALLOW_LOCALHOST=true
CORS_CREDENTIALS=false
CORS_MAX_AGE_SECONDS=86400
TRUST_PROXY=false
BODY_LIMIT_BYTES=1048576

# -----------------------------------------------------------------------------
# PostgreSQL / Prisma
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/powerchain_copilot

# -----------------------------------------------------------------------------
# Authentication / sessions
# -----------------------------------------------------------------------------
SESSION_TTL_DAYS=30

# -----------------------------------------------------------------------------
# AI safety / rate limiting
# -----------------------------------------------------------------------------
AI_RATE_LIMIT=30
AI_RATE_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# -----------------------------------------------------------------------------
# Solana
# -----------------------------------------------------------------------------
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed

# Public chain metadata
TOKEN_2022_PROGRAM=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb

# Environment-specific asset addresses.
# PWRC canonical mainnet-beta mint:
PWRC_MINT=PWRCRXXZxbg6FdQZfK3PMD7KP8xfxs9acvifJiG46wc

# Canonical Solana mainnet USDC mint. For devnet, replace with your dev/test mint.
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# EURC should be set explicitly for the selected environment.
EURC_MINT=

# -----------------------------------------------------------------------------
# Sui read-network
# -----------------------------------------------------------------------------
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# -----------------------------------------------------------------------------
# Pyth
# -----------------------------------------------------------------------------
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes

# -----------------------------------------------------------------------------
# Birdeye
# -----------------------------------------------------------------------------
BIRDEYE_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so

# -----------------------------------------------------------------------------
# Market cache
# -----------------------------------------------------------------------------
MARKET_CACHE_FRESH_MS=30000
MARKET_CACHE_STALE_MS=300000

# -----------------------------------------------------------------------------
# PWRC Copilot Credits
# -----------------------------------------------------------------------------
PWRC_CREDITS_ENABLED=true
PWRC_CREDIT_NETWORK=mainnet-beta
PWRC_CREDIT_RESERVATION_TTL_SECONDS=600
PWRC_CREDIT_ACK_TTL_SECONDS=120
PWRC_CREDIT_REAPER_ENABLED=true
PWRC_CREDIT_REAPER_INTERVAL_SECONDS=60
PWRC_LOW_CREDIT_RESPONSES=10

# Development-only sample grant: 1,000,000 sample PWRC = 100 responses.
PWRC_DEMO_GRANT_ENABLED=true

# Solana Pay funding is disabled until Payment Kernel + treasury are configured.
PWRC_TOPUPS_ENABLED=false
PWRC_TOPUP_TTL_MINUTES=30
PWRC_TREASURY_ADDRESS=
PAYMENT_KERNEL_WEBHOOK_SECRET=
PAYMENT_KERNEL_WEBHOOK_MAX_SKEW_SECONDS=300

# Model Context Protocol (server only)
MCP_ENABLED=false
MCP_ALLOWED_HOSTS=
MCP_SERVERS_JSON=[]
MCP_MAX_SERVERS=8
MCP_MAX_TOOLS=24
MCP_MAX_TOOL_CALLS=4
MCP_MAX_ARGUMENT_BYTES=8192
MCP_MAX_TOOL_SCHEMA_BYTES=65536
MCP_MAX_RESULT_CHARS=12000
MCP_TOOL_TIMEOUT_MS=15000
