{
  "name": "powerchain-capilot-mobile-dapp",
  "version": "1.0.0",
  "private": true,
  "description": "PowerChain Copilot mobile operations application",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "start": "node scripts/mobile-expo.mjs start",
    "start:clear": "node scripts/mobile-expo.mjs start --clear",
    "android": "node scripts/mobile-expo.mjs start --android",
    "ios": "node scripts/mobile-expo.mjs start --ios",
    "web": "node scripts/mobile-expo.mjs start --web",
    "native:android": "node scripts/mobile-expo.mjs run:android",
    "native:ios": "node scripts/mobile-expo.mjs run:ios",
    "prebuild": "node scripts/mobile-expo.mjs prebuild --clean",
    "lint": "pnpm --filter @powerchain/mobile lint",
    "typecheck": "pnpm --filter @powerchain/mobile typecheck",
    "doctor": "pnpm dlx expo-doctor@latest",
    "check": "pnpm verify:workspace && pnpm verify:config && pnpm verify:mcp-sdk && pnpm lint && pnpm typecheck && pnpm server:typecheck && pnpm express:typecheck && pnpm operations:typecheck && pnpm verify:icons && pnpm verify:backend && pnpm docs:typecheck && pnpm verify:api-v1",
    "test:credits": "node --test --experimental-strip-types server/credits/credits.test.ts server/credits/requirements.test.ts",
    "test": "pnpm verify:billing && pnpm verify:credits && pnpm test:mcp && pnpm test:copilot-loop && pnpm test:providers && pnpm test:infra && pnpm test:operations && pnpm test:platform && pnpm test:api-v1",
    "docs:dev": "pnpm --filter @powerchain/docs dev",
    "docs:build": "pnpm --filter @powerchain/docs build",
    "docs:typecheck": "pnpm --filter @powerchain/docs typecheck",
    "server:dev": "tsx server/src/main.ts",
    "server:start": "tsx server/src/main.ts",
    "test:mcp": "node --test --experimental-strip-types packages/mcp-client/mcp-client.test.ts",
    "test:providers": "node --test --experimental-transform-types server/tests/providers.test.ts",
    "test:infra": "node --test --experimental-transform-types server/tests/infra.test.ts",
    "test:python": "cd backend/python && PYTHONPATH=. python3 -m unittest discover -s tests -v && python3 -m compileall -q app tests",
    "verify:backend": "pnpm verify:mcp-sdk && pnpm verify:credits && pnpm test:mcp && pnpm test:copilot-loop && pnpm test:providers && pnpm test:infra && pnpm test:python && node scripts/verify-provider-infra.mjs && pnpm verify:operations && pnpm verify:platform",
    "db:doctor": "node scripts/db-doctor.mjs",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate:status": "prisma migrate status --config prisma.config.ts",
    "test:copilot-loop": "node --test --experimental-transform-types server/tests/mcp-copilot-loop.test.ts",
    "verify:icons": "node scripts/verify-icons.mjs",
    "test:operations": "node --test --experimental-transform-types packages/operations-contracts/operations-contracts.test.ts server/tests/operations.test.ts backend/operations-api/src/services/operations.test.ts",
    "verify:operations": "pnpm test:operations && node scripts/verify-operations.mjs",
    "operations:dev": "pnpm --filter @powerchain/operations-api dev",
    "operations:typecheck": "pnpm --filter @powerchain/operations-api typecheck",
    "test:platform": "node --test --experimental-transform-types server/tests/platform.test.ts",
    "verify:platform": "pnpm test:platform && node scripts/verify-platform-v3.mjs",
    "verify:credits": "pnpm test:credits && node scripts/verify-pwrc-credits.mjs",
    "api:docs": "node --experimental-transform-types scripts/generate-api-artifacts.mjs",
    "verify:api-v1": "pnpm api:docs && pnpm test:api-v1 && node scripts/verify-api-v1.mjs",
    "test:api-v1": "node --test --experimental-transform-types server/tests/api-v1-extensions.test.ts",
    "server:typecheck": "tsc --noEmit -p tsconfig.server.json",
    "express:typecheck": "pnpm --filter @powerchain/mcp-express-gateway typecheck",
    "verify:config": "node scripts/verify-config.mjs",
    "mobile:sync-public": "node scripts/sync-mobile-public.mjs",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "test:billing": "node --test --experimental-transform-types tests/billing-lifecycle.test.ts",
    "verify:billing": "pnpm test:billing && node scripts/verify-authoritative-billing.mjs",
    "verify:mcp-sdk": "node scripts/verify-mcp-sdk.mjs"
  },
  "dependencies": {
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.27.0",
    "react-native-web": "~0.21.0",
    "@prisma/client": "^7.9.1",
    "fastify": "^5.6.0",
    "ioredis": "^5.8.0",
    "mongodb": "^7.0.0",
    "pg": "^8.16.0",
    "@prisma/adapter-pg": "^7.9.1",
    "dotenv": "^17.2.0",
    "expo-notifications": "~56.0.14",
    "expo-splash-screen": "~57.0.5",
    "expo-system-ui": "~57.0.2",
    "@powerchain/operations-contracts": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "prisma": "^7.9.1",
    "tsx": "^4.20.0"
  },
  "type": "module"
}
