{
  "name": "powerchain-copilot-monorepo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.23.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "install:all": "pnpm install",
    "dev": "node scripts/dev-fullstack.mjs",
    "dev:mobile": "pnpm --filter @powerchain/copilot-mobile start",
    "web": "pnpm --filter @powerchain/copilot-mobile web",
    "ios": "pnpm --filter @powerchain/copilot-mobile ios",
    "android": "pnpm --filter @powerchain/copilot-mobile android",
    "api:dev": "pnpm --filter @powerchain/copilot-mobile-api dev",
    "operations:dev": "pnpm --filter @powerchain/energy-platform-backend dev",
    "mcp:dev": "pnpm --filter @powerchain/mcp-express-gateway dev",
    "mcp:python:check": "python3 -m compileall -q services/mcp-python/app services/mcp-python/tests",
    "typecheck": "pnpm -r --if-present typecheck && pnpm run mcp:python:check",
    "verify": "node scripts/verify-monorepo.mjs && node scripts/verify-workspace-boundaries.mjs && node scripts/verify-release.mjs && node scripts/verify-imports.mjs && node scripts/verify-theme.mjs && node scripts/verify-interaction-design.mjs && node scripts/verify-frontend-layout.mjs && node scripts/verify-tsconfig-layout.mjs && node scripts/verify-api-namespace.mjs && node --experimental-strip-types --test apps/api/test/api-namespace.test.ts && node scripts/verify-dependencies.mjs && node scripts/check-env.mjs && node scripts/verify-pwrc-credits.mjs && node --experimental-strip-types --test packages/pwrc-credits/test/*.test.ts && pnpm run verify:mcp && pnpm run verify:providers && pnpm run verify:icons && pnpm run verify:shared && pnpm run verify:energy-platform && pnpm run verify:api-contract && pnpm run verify:operations-hardening",
    "verify:mcp": "node scripts/verify-mcp.mjs && node --experimental-strip-types --test packages/mcp-client/test/*.test.ts && python3 -m compileall -q services/mcp-python/app services/mcp-python/tests",
    "verify:api": "node scripts/verify-api-namespace.mjs && node --experimental-strip-types --test apps/api/test/api-namespace.test.ts",
    "verify:providers": "node scripts/verify-providers-solana.mjs",
    "verify:interaction": "node scripts/verify-interaction-design.mjs",
    "verify:icons": "node scripts/verify-app-icons.mjs",
    "verify:shared": "node scripts/verify-shared-infra.mjs",
    "verify:energy-platform": "node scripts/verify-energy-platform.mjs && node --experimental-strip-types --test packages/energy-contracts/test/*.test.ts",
    "verify:credits": "node scripts/verify-pwrc-credits.mjs && node --experimental-strip-types --test packages/pwrc-credits/test/*.test.ts",
    "env:init": "node scripts/init-env.mjs",
    "env:check": "node scripts/check-env.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "prisma:generate": "pnpm --filter @powerchain/copilot-mobile-api prisma:generate",
    "prisma:migrate": "pnpm --filter @powerchain/copilot-mobile-api prisma:migrate",
    "prisma:deploy": "pnpm --filter @powerchain/copilot-mobile-api prisma:deploy",
    "energy:prisma:generate": "pnpm --filter @powerchain/energy-platform-backend prisma:generate",
    "energy:prisma:migrate": "pnpm --filter @powerchain/energy-platform-backend prisma:migrate",
    "setup": "node scripts/setup-pnpm.mjs",
    "verify:boundaries": "node scripts/verify-workspace-boundaries.mjs",
    "verify:api-contract": "node scripts/verify-api-contract.mjs",
    "verify:operations-hardening": "node scripts/verify-operational-hardening.mjs"
  }
}
