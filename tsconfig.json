{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "apps/mobile/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "apps/mobile/**/*.ts",
    "apps/mobile/**/*.tsx",
    "apps/mobile/.expo/types/**/*.ts",
    "apps/mobile/expo-env.d.ts",
    "apps/mobile/app.config.ts"
  ],
  "exclude": [
    "node_modules",
    "server",
    "backend",
    "apps/docs",
    "packages",
    "scripts",
    "prisma",
    "dist",
    "web-build"
  ]
}
